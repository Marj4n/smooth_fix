{
  "schemaVersion": 1,
  "id": "smooth_fix",
  "version": "${version}",
  "name": "Smooth Fix",
  "description": "Targeted compatibility and stability fixes for Smooth Odyssey on Fabric 1.20.1.",
  "authors": [
    "Marj4n"
  ],
  "contact": {},
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "client": ["org.marj4n.smooth_fix.diagnostics.ClientDiagnostics"],
    "main": [
      "org.marj4n.smooth_fix.SmoothFix"
    ]
  },
  "languageAdapters": {
    "smooth_fix:early_server_compat": "org.marj4n.smooth_fix.bootstrap.ServerCompatibilityAdapter"
  },
  "mixins": [
    {
      "config": "smooth_fix.client.mixins.json",
      "environment": "client"
    },
    {"config": "smooth_fix.server.mixins.json", "environment": "server"},
    "smooth_fix.common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=17"
  },
  "suggests": {
    "emi": "*",
    "emicompat": "*",
    "spell_engine": "*",
    "emi_loot": "*",
    "tumbleweed": "*",
    "obscure_api": "*"
  }
}
